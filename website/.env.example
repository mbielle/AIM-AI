# Public build-time settings. Keep blank until a release is actually qualified.
VITE_AIM_PUBLIC_RELEASE_APPROVED=false
VITE_AIM_MAC_DOWNLOAD_PATH=
VITE_AIM_MAC_DOWNLOAD_SHA256=
# Optional external HTTPS support page; absent means no support UI.
VITE_AIM_SUPPORT_URL=

# Public repository chosen by its owner; no default or inferred destination.
VITE_AIM_SOURCE_URL=
