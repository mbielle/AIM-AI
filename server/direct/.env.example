# No public service is enabled by this file. Supply your own domains/certificate.
AIM_DIRECT_COORDINATOR_DOMAIN=connect.example.org
AIM_DIRECT_RELAY_DOMAIN=relay.example.org
AIM_DIRECT_PUBLIC_IPV4=203.0.113.1
# Generate each independently: openssl rand -hex 32. Keep this file private.
AIM_DIRECT_TURN_SECRET=
AIM_DIRECT_ADMIN_TOKEN=
AIM_DIRECT_HOSTING_QUOTE=./.private/hosting-quote.json
# PEM containing certificate chain and private key for BOTH domains.
AIM_DIRECT_TLS_PEM=./.private/tls.pem
AIM_DIRECT_RELAY_MONTHLY_BYTES=10737418240
