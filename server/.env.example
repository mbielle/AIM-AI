# Use the environment values from YOUR Supabase instance. Never put a server
# key or Apple key in a native client's public configuration.
SUPABASE_URL=https://backend.example.invalid
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Edge -> private gateway override; native client API still requires HTTPS.
# AIM_INTERNAL_SUPABASE_ORIGIN=http://kong:8000
# AIM_INTERNAL_SUPABASE_ALLOW_HTTP=true
# Enable BOTH only on an operator-controlled private network; trust its DNS.
# Push is optional and off until both the bundle topic and Apple credentials exist.
AIM_PUSH_ENABLED=false
AIM_PUSH_WORKER_SECRET=
APNS_ALLOWED_TOPICS=
APNS_ALLOWED_ENVIRONMENTS=production
APNS_PRODUCTION_TEAM_ID=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_PRIVATE_KEY=
# For development/sandbox use the explicit APNS_SANDBOX_* equivalents.
AIM_MONITOR_WORKER_SECRET=
AIM_MONITOR_ALERT_WEBHOOK_URL=
AIM_MONITOR_ALERT_WEBHOOK_TOKEN=
AIM_MONITOR_TELEMETRY_ENABLED=false
