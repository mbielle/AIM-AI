    "project.files.local_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this text snapshot will be kept on this device, in this profile. The original stays unchanged. No upload or model request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule cette copie texte sera conservée sur cet appareil, dans ce profil. L’original reste intact. Aucun envoi ni appel de modèle."
          }
        }
      }
    },
    "project.files.cloud_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm to upload the original file and this locally extracted text to this account’s selected project. No server OCR or model request is used."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez pour envoyer le fichier original et ce texte extrait localement dans le projet sélectionné de ce compte. Aucun OCR serveur ni appel de modèle."
          }
        }
      }
    },
    "project.files.local_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-only text copies, up to 20 files and 128 KB per project. PDF, Office, images and UTF-8 text are read locally. Not included in project sync or profile export."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies texte sur cet appareil uniquement : 20 fichiers et 128 Ko par projet. PDF, Office, images et texte UTF-8 lus localement. Exclus de la synchronisation des projets et de l’export du profil."
          }
        }
      }
    },
    "project.files.use_chat": {
