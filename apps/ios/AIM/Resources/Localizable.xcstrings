{
  "sourceLanguage": "en",
  "strings": {
    "·": {
      "comment": "A separator between tokens and cost.",
      "isCommentAutoGenerated": true
    },
    "%@ · %@": {
      "comment": "A subtext that displays the file size and the source of the uploaded file.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A label showing the number of items selected for deletion. The argument is the number of selected items.",
      "isCommentAutoGenerated": true
    },
    "%lld attachment(s)": {},
    "%lld files": {},
    "%lld files · +%lld −%lld": {
      "comment": "A heading that describes the number of files and the total number of additions and deletions in the diff. The first argument is the number of files. The second argument is the number of additions. The third argument is the number of deletions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld files · +%2$lld −%3$lld"
          }
        }
      }
    },
    "%lld.": {
      "comment": "A number followed by a period. The argument is the number of the item in the list.",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A label displaying the index of the currently selected message in a list of search results. The first argument is the index of the selected message. The second argument is the total number of search results.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld/2000": {
      "comment": "A counter showing the number of characters in the user's profile preferences. The argument is the number of characters in the user's profile preferences.",
      "isCommentAutoGenerated": true
    },
    "•": {
      "comment": "A bullet point.",
      "isCommentAutoGenerated": true
    },
    "+%lld": {
      "comment": "A plus sign followed by the number of additions in a tool group.",
      "isCommentAutoGenerated": true
    },
    "−%lld": {
      "comment": "A minus sign followed by the number of deletions in a tool group. The number is positive.",
      "isCommentAutoGenerated": true
    },
    "$ %@": {
      "comment": "A label showing the command that was run in the terminal. The argument is the command that was run in the terminal.",
      "isCommentAutoGenerated": true
    },
    "0": {
      "comment": "A placeholder for the number of matching messages.",
      "isCommentAutoGenerated": true
    },
    "5": {
      "comment": "A number of turns.",
      "isCommentAutoGenerated": true
    },
    "10": {
      "comment": "The number of turns for a goal.",
      "isCommentAutoGenerated": true
    },
    "20": {
      "comment": "The number of turns to play a game of 20 Questions.",
      "isCommentAutoGenerated": true
    },
    "30 days": {
      "comment": "The number of days in the 30-day option for the user to choose how many days of their library are retained.",
      "isCommentAutoGenerated": true
    },
    "60 days": {
      "comment": "The text for a 60-day retention period.",
      "isCommentAutoGenerated": true
    },
    "90 days": {
      "comment": "The label for the 90-day retention period in the settings.",
      "isCommentAutoGenerated": true
    },
    "365 days": {
      "comment": "The number of days in a year.",
      "isCommentAutoGenerated": true
    },
    "A redacted JSON report contains command stages and safe error codes, never messages, tokens, email addresses, or complete paths.": {
      "comment": "A description of the contents of the diagnostic report.",
      "isCommentAutoGenerated": true
    },
    "About": {
      "comment": "The name of the \"About\" screen in the settings app.",
      "isCommentAutoGenerated": true
    },
    "Add or move to project": {
      "comment": "A button that adds a conversation to a project.",
      "isCommentAutoGenerated": true
    },
    "Add to project": {
      "comment": "A title for a panel that allows the user to add a conversation to a project.",
