    "project.files.send_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future text messages in this project will attach this copy to the chosen provider. Account conversations may also sync the attachment. Nothing is sent until you send a message. Up to 4 attachments per message, including your other files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prochains messages texte de ce projet joindront cette copie au fournisseur choisi. Les conversations de compte peuvent aussi synchroniser la pièce jointe. Rien n’est envoyé avant un message. Limite de 4 pièces jointes par message, avec vos autres fichiers."
          }
        }
      }
    },
