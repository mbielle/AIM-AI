    "remote.error.server_rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Remote server is receiving too many commands for this account. Wait a minute, then send again. Your draft has been kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur Remote reçoit trop de commandes pour ce compte. Attendez une minute, puis réessayez. Votre brouillon est conservé."
          }
        }
      }
    },
    "remote.error.server_queue_full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Remote server’s command queue is full. Wait for pending commands to finish, then send again. Your draft has been kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file de commandes de votre serveur Remote est pleine. Attendez que des commandes en attente se terminent, puis réessayez. Votre brouillon est conservé."
