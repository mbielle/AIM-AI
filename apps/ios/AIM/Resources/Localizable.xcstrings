    "project.sources.text_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This earlier source contains a text copy only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ancienne source contient uniquement une copie texte."
          }
        }
      }
    },
    "project.sources.text_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep text within 8 MB and omit null characters. The previous text was kept unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitez le texte à 8 Mo, sans caractère nul. Le texte précédent est conservé sans modification."
          }
        }
      }
    },
    "chat.error.web_budget.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web search and your protected budget"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche web et budget protégé"
          }
        }
      }
    },
    "chat.error.web_budget.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic web search has no verified maximum cost. Turn it off to keep this iPhone’s budget protection. Your draft is kept; send it again when you are ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coût maximal de la recherche web automatique ne peut pas être vérifié. Désactivez-la pour conserver la protection du budget de cet iPhone. Votre brouillon est conservé ; renvoyez-le quand vous le souhaitez."
          }
        }
      }
    },
    "chat.error.web_budget.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off automatic web search"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver la recherche web automatique"
          }
        }
      }
    },
    "chat.error.web_budget.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement…"
          }
        }
      }
    },
    "chat.error.web_budget.save_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preference could not be saved. Your draft and budget are unchanged. Try again when synchronization is finished."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La préférence n’a pas pu être enregistrée. Votre brouillon et votre budget sont inchangés. Réessayez une fois la synchronisation terminée."
          }
        }
      }
    },
    "project.sources.rename": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommer"
          }
        }
      }
    },
    "project.sources.source_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source title"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre de la source"
          }
        }
      }
    },
    "project.sources.rename_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the title changes. The original, saved text and context setting stay the same."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le titre change. Le fichier original, le texte conservé et le réglage de contexte restent identiques."
          }
        }
      }
    },
    "project.sources.rename_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–255 characters and at most 1 KB, without slashes or control characters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1 à 255 caractères et au plus 1 Ko, sans barre oblique ni caractère de contrôle."
          }
        }
      }
    },
    "project.sources.rename_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rename could not be completed. Reopen the list to check its title. The saved content is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage n’a pas pu être terminé. Rouvrez la liste pour vérifier le titre. Le contenu conservé est inchangé."
          }
        }
      }
    },
    "budget.estimated_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated spending limit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de dépenses estimée"
          }
        }
      }
    },
    "budget.verified_web_maximum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict budget protection"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection stricte du budget"
          }
        }
      }
    },
    "budget.estimate_coverage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated mode counts known charges and reservations. Completed historical charges without an amount remain listed as unknown and are excluded from the estimated subtotal; pending unresolved charges still block sending. Unreported web fees and extra search tokens can exceed the estimate. Strict protection requires complete history and a verified request maximum. This is not a provider billing cap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode estimatif compte les coûts connus et les réservations. Les anciennes opérations terminées sans montant restent signalées comme inconnues et sont exclues du sous-total estimé ; les opérations non résolues bloquent encore l’envoi. Les frais web non communiqués et les tokens supplémentaires peuvent dépasser l’estimation. La protection stricte exige un historique complet et un maximum vérifié pour la requête. Ce réglage ne plafonne pas la facture du fournisseur."
          }
        }
      }
    },
    "budget.web_estimate_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated budget: unreported web-search fees and extra search tokens are excluded. The provider may charge more."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget estimatif : les frais web non communiqués et les tokens supplémentaires de recherche sont exclus. Le fournisseur peut facturer davantage."
          }
        }
      }
    },
    "budget.web_cost_incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreported web-search fees are excluded from this estimate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais de recherche web non communiqués sont exclus de cette estimation."
          }
        }
      }
    },
    "response.information": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response information"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations sur la réponse"
          }
        }
      }
    },
    "response.cost_confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total reported by the provider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Total communiqué par le fournisseur."
          }
        }
      }
    },
    "response.cost_estimated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Costs are estimates when available, not a provider invoice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coûts disponibles sont estimatifs et ne constituent pas une facture du fournisseur."
          }
        }
      }
    },
    "budget.web_search_behavior": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model searches when useful. With an estimated budget, unreported search fees may exceed the limit. Verified-maximum mode blocks web search."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle recherche si nécessaire. Avec un budget estimatif, les frais de recherche non communiqués peuvent dépasser la limite. Le mode à maximum vérifié bloque la recherche web."
          }
        }
      }
    },
    "response.cost_reconstructed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstructed estimate from saved tokens and current catalog prices; unreported web fees are excluded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation reconstituée à partir des tokens enregistrés et du tarif actuel du catalogue ; frais web non communiqués exclus."
          }
        }
      }
    },
    "budget.unknown_completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed requests with unknown charges"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opérations terminées au coût inconnu"
          }
        }
      }
    },
    "budget.unknown_history_coverage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These amounts are still unknown, not free. Estimated mode excludes them from its subtotal; strict mode blocks new requests until the history is complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces montants restent inconnus, pas gratuits. Le mode estimatif les exclut de son sous-total ; le mode strict bloque les nouvelles requêtes tant que l’historique est incomplet."
          }
        }
      }
    },
    "notice.expanded": {
